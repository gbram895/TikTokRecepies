# Local dev defaults to SQLite; Render will inject a Postgres DATABASE_URL for you.
DATABASE_URL=sqlite:///./app.db

# Random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# faster-whisper model size: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=tiny

# Read on-screen text (ingredient cards, step captions) via local OCR.
# Adds an ffmpeg frame-extraction + tesseract subprocess per video on top
# of the resident Whisper model -- fine locally or on a roomier plan, but
# can exceed Render's free 512MB web service plan. Set to false there.
ENABLE_OCR=true
