# --- Used when running `uvicorn app.main:app` directly (bare-metal/local) ---
# Local dev defaults to SQLite. Ignored by docker-compose (see below), which
# builds DATABASE_URL itself from the POSTGRES_* vars instead.
DATABASE_URL=sqlite:///./app.db

# Random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# faster-whisper model size: tiny, base, small, medium, large-v3
# "small" is a good default with headroom to spare (e.g. an Oracle Cloud
# free VM). Drop to "tiny" for a snappier loop on a laptop, or if deploying
# somewhere memory-constrained.
WHISPER_MODEL_SIZE=small

# Read on-screen text (ingredient cards, step captions) via local OCR.
# Adds an ffmpeg frame-extraction + tesseract subprocess per video on top
# of the resident Whisper model -- fine with a few GB of RAM to spare, but
# can exceed a memory-capped host (e.g. Render's free 512MB web service
# plan). Set to false there.
ENABLE_OCR=true

# --- Used only by docker-compose.yml (ignored for bare-metal runs above) ---
# Credentials for the Postgres container; docker-compose assembles
# DATABASE_URL from these for the app container automatically.
POSTGRES_USER=tiktok_recipes
POSTGRES_PASSWORD=change-me-to-a-random-password
POSTGRES_DB=tiktok_recipes
