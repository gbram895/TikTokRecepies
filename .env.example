# Local dev defaults to SQLite; Render will inject a Postgres DATABASE_URL for you.
DATABASE_URL=sqlite:///./app.db

# Random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# Anthropic API key used to turn transcripts into structured recipes.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# faster-whisper model size: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
